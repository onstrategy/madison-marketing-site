      "headings": [
        {
          "text": "Turn Research Output into a Presentation-Ready File.",
          "level": 2,
          "sourceClasses": [
            "h3",
            "bigger"
          ]
        }
      ],
      "paragraphs": [
        "When your research or draft is ready, ask Madison AI to generate a slide deck from your last chat. It builds the slides, writes speaker notes, and organizes the content. What used to take hours now takes one prompt. Please note - this feature is still in beta. Primary brand colors can be applied, but branded templates are not yet supported."
      ],
      "listItems": [],
      "quotes": [
        {
          "text": "\"It would've taken a couple of hours to put into an actual PowerPoint coming from somebody who spent a lot of my early career doing that. It now takes minutes.\"",
          "attribution": "Kristine Richter, Head of Customer Success, Madison AI",
          "portrait": {
            "url": "https://cdn.prod.website-files.com/691d9787eade11d4963fe1d2/69c151ac0f31d4619586ead1_kristine.avif",
            "alt": "Kristine Richter, Head of Customer Success, Madison AI"
