{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // Turbo hides any env var not listed here from the task it runs. The site
      // reads these two to build its canonical tags and sitemap
      // (apps/site/src/site-origin.server.ts); unlisted, they never arrive and
      // the build silently falls back to the *.netlify.app address.
      "env": ["SITE_ORIGIN", "URL"],
      // dist-ssr is @madison/site's prerender bundle. Cached alongside dist so a
      // cache hit can't leave the prerender step without the entry it renders from.
      "outputs": ["dist/**", "dist-ssr/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "tsconfig*.json", "package.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "vitest.config.*", "package.json"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false,
      "outputs": []
    }
  }
}
